// Cloudflare Workers Static Assets: serves dist/ with no Worker script (static requests are free and unlimited).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "simplystylo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "simplystylo.com", "custom_domain": true }]
}
