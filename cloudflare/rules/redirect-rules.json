{
  "description": "Redirect www to non-www canonical apex domain (simplystylo.com)",
  "rules": [
    {
      "action": "redirect",
      "action_parameters": {
        "from_value": {
          "preserve_query_string": true,
          "status_code": 301,
          "target_url": {
            "expression": "concat(\"https://simplystylo.com\", http.request.uri.path)"
          }
        }
      },
      "description": "Redirect www.simplystylo.com to simplystylo.com",
      "enabled": true,
      "expression": "(http.host eq \"www.simplystylo.com\")"
    }
  ]
}
