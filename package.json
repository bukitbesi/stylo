{
  "name": "simplystylo",
  "version": "1.0.0",
  "private": true,
  "description": "SimplyStylo.com: free style tools for colors, sizes and outfits. Zero-dependency static build.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test tests/*.test.mjs",
